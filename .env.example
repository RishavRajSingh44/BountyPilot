# Server only. Optional public-read-only token; never use NEXT_PUBLIC_ here.
GITHUB_TOKEN=
GEMMA_MODEL=gemma3:4b
# Select only an installed model: gemma3:4b preferred, gemma3:1b optional.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Remote endpoints require HTTPS and a server-side bearer API key.
OLLAMA_API_KEY=
BOUNTYPILOT_DATA_DIR=data
# Optional database file override; relative paths resolve from project root.
DATABASE_PATH=
BOUNTYPILOT_CACHE_DIR=.cache
BOUNTYPILOT_LOG_DIR=data/logs
BOUNTYPILOT_BUILD_DIR=.next
APP_ORIGIN=http://127.0.0.1:3000
